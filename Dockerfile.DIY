FROM docker.io/golang:1.26.4-bookworm AS builder

ARG VERSION=dev
ARG TARGETARCH
WORKDIR /go/src/headscale

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} go build \
    -ldflags="-s -w" \
    -o /go/bin/headscale ./cmd/headscale

FROM debian:trixie-slim

RUN apt-get update && apt-get install --no-install-recommends --yes \
    ca-certificates \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /go/bin/headscale /usr/local/bin/headscale

EXPOSE 8080/tcp
EXPOSE 9090/tcp
EXPOSE 50443/tcp

VOLUME ["/var/lib/headscale", "/etc/headscale"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/headscale"]
CMD ["serve"]